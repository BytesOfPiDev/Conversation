graphs (name,path) VALUES (&quot;some_name&quot;, &quot;some/path/somewhere&quot;);*/
INSERT INTO nodes (graph, graph_node_id)
WITH const AS (
	SELECT 'some_name' AS graphName, 'some/path/somewhere' AS graphPath
)
SELECT
	graphs.id,
	10
FROM graphs, const
WHERE graphs.name= const.graphName AND graphs.path = const.graphPath;
